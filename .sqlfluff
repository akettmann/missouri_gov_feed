[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 120
# Column alignment in the models is deliberate; don't fight it.
# RF04: domain column names like `source`, `date`; ST07: `using` joins read better on composite keys.
# ST05: the portable mogov.json_elements() macro must render a lateral subquery in the join.
exclude_rules = layout.spacing, structure.column_order, references.keywords, structure.using, structure.subquery
large_file_skip_byte_limit = 50000
# committee_names.sql macros render ~16 nested regexp_replace calls per name key; the default 600 is too
# shallow for int_mec__donor_committees.
max_parse_depth = 2000

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent
