{
  "name": "mogov-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/export-sizes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
