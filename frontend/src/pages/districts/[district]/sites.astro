---
// Every EPA-regulated site in one district or city, the full list behind the profile's "Businesses in their
// area" section (which carries only counts by industry and the donor-tied sites). Same columns for every
// district; no filtering or ranking, and the CSV beside it has the same rows.
import AwardBadges from "../../../components/AwardBadges.astro";
import type { GetStaticPaths } from "astro";
import ConfidenceBadge from "../../../components/ConfidenceBadge.astro";
import SourceLink from "../../../components/SourceLink.astro";
import ConfidenceToggle from "../../../components/ConfidenceToggle.astro";
import Layout from "../../../layouts/Layout.astro";
import { districtSiteLists, districtSites } from "../../../lib/exports/districtSites";
import { allOfficials } from "../../../lib/exports/load";
import { count, officeLine } from "../../../lib/format";
import { href } from "../../../lib/site";

export const getStaticPaths = (async () => {
  const lists = await districtSiteLists();
  const bySlug = new Map((await allOfficials()).map((b) => [b.official.slug, b.official]));
  return [...(lists?.values() ?? [])].map((l) => ({
    params: { district: l.slug },
    props: { list: l, official: bySlug.get(l.official_slug)! },
  }));
}) satisfies GetStaticPaths;

const { list, official } = Astro.props;
const sites = await districtSites(list.district_id);
const area = officeLine(official);
---

<Layout
  title={`EPA-regulated sites: ${area}`}
  description={`All ${count(list.n_sites)} EPA-regulated sites in the area of ${area}.`}
>
  <div class="site-list-page">
    <h1>EPA-regulated sites in this area</h1>
    <p class="lede">
      All {count(sites.length)} sites that EPA or a state environmental program regulates in the area
      represented by <a href={href(`/officials/${official.slug}/`)}>{area}</a> ({official.full_name}
      <AwardBadges slug={official.slug} />
      ). The list is the same for every area: a site appears here because of where it is, not because of who
      owns it. Sites tied to a company that gave this official money, by name or listed brand, come first. A
      "same company" match means a donor with the same brand gave, not necessarily the owner of the site.{" "}
      <a href={href("/methodology/#district-businesses")}>How it's matched</a>.
    </p>
    <p class="small">
      <a href={href(`/districts/${list.slug}/sites.csv`)} download>
        Download as CSV
      </a>{" "}
      · <a href={href(`/officials/${official.slug}/#businesses`)}>Back to the profile</a>
    </p>
    <p class="small">
      <ConfidenceToggle />
    </p>
    <p class="small muted limits">
      Limits: only EPA-regulated sites are listed (factories, fuel stations, utilities, repair shops, farms
      with permits), so offices, stores and most service businesses are missing. A site's presence says
      nothing about its conduct; being regulated is routine.
    </p>
    <div class="table-scroll card list">
      <table>
        <caption class="sr-only">{`Sites in ${area}`}</caption>
        <thead>
          <tr>
            <th scope="col">Site</th>
            <th scope="col">Address</th>
            <th scope="col">Industry</th>
            <th scope="col">Owner</th>
            <th scope="col">Matching donor</th>
            <th scope="col">Record</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((s) => (
            <tr data-confidence={s.match_confidence === "medium" ? "medium" : undefined}>
              <td>{s.facility_name ?? "unnamed site"}</td>
              <td>
                {[s.address, s.city].filter(Boolean).join(", ")} {s.postal_code}
              </td>
              <td>{s.naics_description ?? "no industry code"}</td>
              <td>{s.parent_company_name ?? s.owner_name ?? "not listed"}</td>
              <td>
                {s.is_donor ? (
                  <>
                    {s.donor_names} <SourceLink url={s.contributions_url} label="reports" missing="" />{" "}
                    <ConfidenceBadge confidence={s.match_confidence} />
                    <span class="muted small">
                      {" "}
                      ({s.matched_by === "same company" ? "same brand" : s.matched_by})
                    </span>
                  </>
                ) : (
                  "No match"
                )}
              </td>
              <td>
                {s.frs_url && (
                  <a href={s.frs_url} rel="noopener noreferrer" target="_blank">
                    EPA record
                    <span class="sr-only"> for {s.facility_name ?? "unnamed site"}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<style is:global>
  .site-list-page h1 {
    margin-top: 24px;
  }
  .site-list-page .limits {
    max-width: 72ch;
  }
  .site-list-page .list {
    padding: 4px 8px;
  }
</style>
