---
// One past year of the browse list as a plain page, so the look-back works without JavaScript.
// The home page links here inside <noscript>; the same rows feed lookup/officeholders/<year>.json.
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { pastOfficeholders } from "../../lib/exports/load";
import type { PastOfficeholder } from "../../lib/exports/types";
import { LEVELS, officeLine } from "../../lib/format";
import { href } from "../../lib/site";

export const getStaticPaths = (async () => {
  const past = await pastOfficeholders();
  const years = [...(past?.years.keys() ?? [])].sort((a, b) => b - a);
  return [...(past?.years ?? [])].map(([year, rows]) => ({
    params: { year: String(year) },
    props: { rows, year, years, currentYear: past!.currentYear },
  }));
}) satisfies GetStaticPaths;

const { rows, year, years, currentYear } = Astro.props as {
  rows: PastOfficeholder[];
  year: number;
  years: number[];
  currentYear: number;
};
---

<Layout title={`Served in ${year}`}>
  <h1>Missouri officials who served in {year}</h1>
  <p class="lede">
    Everyone recorded as holding these offices at some point in {year}. Names link to a profile only for
    people serving now. Offices without dated rosters for {year} are not listed.
  </p>
  <nav aria-label="Other years" class="small">
    <a href={href("/")}>{currentYear} (serving now)</a>
    {years
      .filter((y) => y !== year)
      .map((y) => (
        <>
          {" "}
          · <a href={href(`/years/${y}/`)}>{y}</a>
        </>
      ))}
  </nav>
  <p class="small muted">
    {rows.length} officeholders in {year}
  </p>
  <div class="table-scroll card list">
    <table aria-label={`Officeholders in ${year}`}>
      <thead>
        <tr>
          <th>Name</th>
          <th>Office</th>
          <th>Party</th>
          <th>Level</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((o) => (
          <tr>
            <td>{o.slug ? <a href={href(`/officials/${o.slug}/`)}>{o.full_name}</a> : o.full_name}</td>
            <td>{officeLine(o)}</td>
            <td>{o.party ?? <span class="muted">none listed</span>}</td>
            <td>{LEVELS[o.level] ?? o.level}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>

<style>
  h1 {
    margin-top: 24px;
  }
  nav {
    margin: 8px 0;
  }
  .list {
    padding: 4px 8px;
  }
</style>
