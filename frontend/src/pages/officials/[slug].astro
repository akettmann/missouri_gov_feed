---
// One prerendered profile per official. Identical layout for everyone: every section always renders,
// and says why when it's empty.
import type { GetStaticPaths } from "astro";
import ConfidenceToggle from "../../components/ConfidenceToggle.astro";
import CoverageStrip from "../../components/CoverageStrip.astro";
import SectionBusinesses from "../../components/SectionBusinesses.astro";
import SectionCourts from "../../components/SectionCourts.astro";
import SectionGifts from "../../components/SectionGifts.astro";
import SectionIdeology from "../../components/SectionIdeology.astro";
import SectionInterests from "../../components/SectionInterests.astro";
import SectionMoney from "../../components/SectionMoney.astro";
import SectionOverlap from "../../components/SectionOverlap.astro";
import SectionVoting from "../../components/SectionVoting.astro";
import Layout from "../../layouts/Layout.astro";
import { allOfficials } from "../../lib/exports/load";
import type { OfficialBundle } from "../../lib/exports/types";
import { LEVELS, officeLine, visibleCoverage } from "../../lib/format";
import { href, reportErrorUrl } from "../../lib/site";

export const getStaticPaths = (async () =>
  (await allOfficials()).map((bundle) => ({
    params: { slug: bundle.official.slug },
    props: { bundle },
  }))) satisfies GetStaticPaths;

interface Props {
  bundle: OfficialBundle;
}
const { bundle } = Astro.props;
const o = bundle.official;
const bias = bundle.coverage.find((c) => c.key === "bias")!;
const jsonUrl = href(`/officials/${o.slug}.json`);
const term = [o.current_term_start, o.current_term_end].filter(Boolean).join(" to ");
---

<Layout title={o.full_name} description={`Evidence on ${o.full_name}: ${officeLine(o)}.`}>
  <article data-bundle-url={jsonUrl}>
    <header class="profile-head">
      {o.image_url && (
        <img src={o.image_url} alt="" width="96" height="120" loading="lazy" referrerpolicy="no-referrer" />
      )}
      <div class="who">
        <p class="small muted crumbs">
          <a href={href("/")}>Officials</a> / {LEVELS[o.level] ?? o.level}
        </p>
        <h1>{o.full_name}</h1>
        <p class="office">{officeLine(o)}</p>
        <p class="small muted facts">
          <span>Party: {o.party ?? "none listed (non-partisan office or not recorded)"}</span>
          {term && <span>Current term: {term}</span>}
          {o.hometown && <span>Hometown: {o.hometown}</span>}
        </p>
      </div>
    </header>

    <CoverageStrip items={visibleCoverage(bundle.coverage)} />

    <div class="tools small">
      <ConfidenceToggle />
      <a href={jsonUrl} download>
        Download this data (JSON)
      </a>
      <a class="js-only" href={href(`/compare/?a=${o.slug}`)}>
        Compare with another official
      </a>
      <a href={reportErrorUrl(o.full_name, Astro.url.pathname)} rel="noopener" target="_blank">
        Report an error
      </a>
    </div>

    <SectionIdeology
      indicators={bundle.indicators}
      status={bias.status}
      peers={bundle.peers}
      office={o.office}
    />
    <SectionVoting bundle={bundle} />
    <SectionMoney bundle={bundle} />
    <SectionGifts bundle={bundle} />
    <SectionOverlap bundle={bundle} />
    <SectionBusinesses bundle={bundle} />
    <SectionInterests bundle={bundle} />
    <SectionCourts bundle={bundle} />
  </article>
</Layout>

<script>
  import "../../scripts/profile";
</script>

<style>
  .profile-head {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-top: 24px;
  }
  .profile-head img {
    border-radius: 8px;
    object-fit: cover;
    background: var(--surface-2);
    flex: none;
  }
  h1 {
    margin: 0;
    font-size: 1.75rem;
  }
  .crumbs {
    margin: 0 0 4px;
  }
  .office {
    margin: 4px 0;
    font-size: 1.0625rem;
    color: var(--ink-2);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin: 16px 0 0;
  }
  @media (max-width: 520px) {
    .profile-head img {
      width: 72px;
      height: 90px;
    }
  }
</style>
