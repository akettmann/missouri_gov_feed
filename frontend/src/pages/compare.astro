---
// Compare two officials side by side: the same measured numbers from each profile, in matching rows.
// Rendered in the browser from the per-official JSON; both choices live in the URL (?a=slug&b=slug).
import ConfidenceToggle from "../components/ConfidenceToggle.astro";
import OfficeFilter from "../components/OfficeFilter.astro";
import Layout from "../layouts/Layout.astro";
import { pluralOfficeLabel } from "../lib/awardBadges";
import { currentAwardsBySlug } from "../lib/exports/awards";
import { officialIndex } from "../lib/exports/load";
import { officeLine } from "../lib/format";
import { buildOfficeGroups } from "../lib/lookback";
import { href } from "../lib/site";

const awards = await currentAwardsBySlug();
// badges only for officials who hold awards, so the inline index stays small
const current = await officialIndex();
// the office key lets the filter bar narrow the pickers; chip labels use the shared helper because
// office_title is circuit-specific for judges
const groups = buildOfficeGroups(
  current.map((o) => ({ office: o.office, office_title: pluralOfficeLabel(o.office) })),
);
const officials = current.map((o) => ({
  slug: o.slug,
  office: o.office,
  label: `${o.full_name} — ${officeLine(o)}`,
  ...(awards.has(o.slug) && { badges: awards.get(o.slug) }),
}));
---

<Layout title="Compare officials" description="Compare two Missouri officials' records side by side.">
  <h1>Compare officials</h1>
  <p class="lede">
    Pick two officials to see the same measures side by side. Each name links to that profile, where every
    number has its source.
  </p>

  <form class="pickers card js-only" onsubmit="return false">
    <label>
      First official
      <input name="a" list="officials" placeholder="Start typing a name" autocomplete="off" />
    </label>
    <label>
      Second official
      <input name="b" list="officials" placeholder="Start typing a name" autocomplete="off" />
    </label>
    <datalist id="officials">
      {officials.map((o) => (
        <option value={o.label} />
      ))}
    </datalist>
    <div class="office-bar">
      <OfficeFilter groups={groups} />
      <p class="small muted">
        The lists above offer officials from the office you pick here. It follows your first pick; choose
        &ldquo;All offices&rdquo; to compare across offices.
      </p>
      <p class="small muted" id="filter-status" role="status"></p>
    </div>
  </form>
  <div class="small tools">
    <ConfidenceToggle />
  </div>
  <noscript>
    <p class="card">
      Comparing needs JavaScript. You can still open each official's profile from the{" "}
      <a href={href("/")}>list of officials</a>.
    </p>
  </noscript>
  <p class="small muted js-only" id="status" aria-live="polite">
    Choose two officials.
  </p>
  <div class="card table-scroll" id="result" hidden></div>

  <script is:inline type="application/json" id="officials-index" set:html={JSON.stringify(officials)} />
</Layout>

<script>
  import { renderBadges, type Badge } from "../lib/awardBadges";
  import { compareRows } from "../lib/compare";
  import { filterForOffice, filterOfficials, reconcileFilter, type OfficeFilter } from "../lib/compareFilter";
  import type { OfficialBundle } from "../lib/exports/types";

  const index: { slug: string; office: string; label: string; badges?: Badge[] }[] = JSON.parse(
    document.getElementById("officials-index")!.textContent!,
  );
  const bySlug = new Map(index.map((o) => [o.slug, o.label]));
  const badgesBySlug = new Map(index.map((o) => [o.slug, o.badges ?? []]));
  const byLabel = new Map(index.map((o) => [o.label, o.slug]));
  const form = document.querySelector<HTMLFormElement>("form.pickers")!;
  const status = document.getElementById("status")!;
  const filterStatus = document.getElementById("filter-status")!;
  const datalist = document.getElementById("officials") as HTMLDataListElement;
  const chipSets = [...form.querySelectorAll<HTMLFieldSetElement>("fieldset.chips")];
  const officeBySlug = new Map(index.map((o) => [o.slug, o.office]));
  const result = document.getElementById("result")!;
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  const cache = new Map<string, Promise<OfficialBundle>>();
  const bundle = (slug: string) => {
    if (!cache.has(slug))
      cache.set(
        slug,
        fetch(`${base}/officials/${slug}.json`).then((r) => r.json()),
      );
    return cache.get(slug)!;
  };
  const hideMedium = () => document.documentElement.classList.contains("hide-medium");

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, cls?: string) {
    const e = document.createElement(tag);
    if (text != null) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  }

  // the bar follows the first pick until the visitor uses it themselves
  let touched = false;

  function currentFilter(): OfficeFilter {
    const group = String(new FormData(form).get("group") ?? "");
    // the office comes only from the visible chip set: the radios share one name, so a checked radio in a
    // hidden set must not narrow the list
    const office = chipSets
      .find((s) => s.dataset.group === group)
      ?.querySelector<HTMLInputElement>("input:checked");
    return { group, office: office?.value ?? "" };
  }

  function setFilter(f: OfficeFilter) {
    f = reconcileFilter(f);
    const tiles = [...form.querySelectorAll<HTMLInputElement>('input[name="group"]')];
    const tile = tiles.find((r) => r.value === f.group) ?? tiles.find((r) => r.value === "");
    for (const r of tiles) r.checked = r === tile;
    for (const r of form.querySelectorAll<HTMLInputElement>('input[name="office"]')) r.checked = false;
    // check the chip (or "All") inside the shown group's set; the sets share one radio group
    const set = chipSets.find((s) => s.dataset.group === tile?.value);
    const inputs = [...(set?.querySelectorAll<HTMLInputElement>("input") ?? [])];
    const chip = inputs.find((r) => r.value === f.office) ?? inputs.find((r) => r.value === "");
    if (chip) chip.checked = true;
  }

  function applyFilter() {
    const f = currentFilter();
    for (const set of chipSets) set.hidden = set.dataset.group !== f.group;
    const shown = filterOfficials(index, f);
    datalist.replaceChildren(
      ...shown.map((o) => {
        const opt = el("option");
        opt.value = o.label;
        return opt;
      }),
    );
    const group = form.querySelector<HTMLInputElement>('input[name="group"]:checked')?.closest("label");
    const chip = f.office
      ? chipSets
          .find((s) => s.dataset.group === f.group)
          ?.querySelector<HTMLInputElement>("input:checked")
          ?.closest("label")
      : null;
    const where = (chip ?? group)?.textContent?.trim() ?? "";
    filterStatus.textContent = f.group
      ? `Showing ${shown.length} officials: ${where}.`
      : `Showing all ${shown.length} officials.`;
  }

  async function render() {
    const slugs = ["a", "b"].map((k) => byLabel.get(String(new FormData(form).get(k) ?? "")));
    const chosen = slugs.filter((s): s is string => !!s);
    const params = new URLSearchParams();
    slugs.forEach((s, i) => s && params.set(i ? "b" : "a", s));
    const f = currentFilter();
    if (f.group) params.set("group", f.group);
    if (f.office) params.set("office", f.office);
    history.replaceState(null, "", params.size ? `?${params}` : location.pathname);
    if (chosen.length < 2) {
      result.hidden = true;
      status.textContent = chosen.length ? "Choose a second official." : "Choose two officials.";
      return;
    }
    status.textContent = "Loading…";
    const bundles = await Promise.all(chosen.map(bundle));
    const table = el("table");
    const head = el("tr");
    head.append(el("th", "Measure"));
    for (const b of bundles) {
      const th = el("th");
      const a = el("a", b.official.full_name);
      (a as HTMLAnchorElement).href = `${base}/officials/${b.official.slug}/`;
      th.append(a);
      th.append(
        document
          .createRange()
          .createContextualFragment(renderBadges(badgesBySlug.get(b.official.slug) ?? [], base)),
      );
      head.append(th);
    }
    const thead = el("thead");
    thead.append(head);
    const tbody = el("tbody");
    let section = "";
    for (const row of compareRows(bundles, hideMedium())) {
      if (row.section !== section) {
        section = row.section;
        const tr = el("tr", undefined, "section");
        const th = el("th", section);
        th.colSpan = bundles.length + 1;
        tr.append(th);
        tbody.append(tr);
      }
      const tr = el("tr");
      const label = el("td", row.label);
      if (row.note) label.append(el("div", row.note, "small muted"));
      tr.append(label);
      for (const v of row.values) tr.append(el("td", v));
      tbody.append(tr);
    }
    table.append(thead, tbody);
    result.replaceChildren(table);
    result.hidden = false;
    status.textContent = "";
  }

  // restore a shared comparison (?a=slug&b=slug)
  const params = new URLSearchParams(location.search);
  for (const k of ["a", "b"]) {
    const label = bySlug.get(params.get(k) ?? "");
    if (label) (form.elements.namedItem(k) as HTMLInputElement).value = label;
  }
  if (params.has("group") || params.has("office")) {
    touched = true;
    setFilter({ group: params.get("group") ?? "", office: params.get("office") ?? "" });
  } else {
    setFilter(
      filterForOffice(officeBySlug.get(byLabel.get(String(new FormData(form).get("a") ?? "")) ?? "")),
    );
  }
  applyFilter();
  form.addEventListener("input", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLInputElement)) return;
    if (t.name === "group" || t.name === "office") {
      touched = true;
      if (t.name === "group") {
        // a new tile starts from all of its offices
        setFilter({ group: t.value, office: "" });
      }
      applyFilter();
      void render();
      return;
    }
    if (t.name === "a" && !touched) {
      const a = byLabel.get(t.value);
      if (a || !t.value) {
        setFilter(filterForOffice(a && officeBySlug.get(a)));
        applyFilter();
      }
    }
  });
  form.addEventListener("change", (e) => {
    // the filter radios already rendered from their input event
    const t = e.target;
    if (t instanceof HTMLInputElement && (t.name === "group" || t.name === "office")) return;
    void render();
  });
  form.addEventListener("input", (e) => {
    // the filter radios render from their own handler above
    if (e.target instanceof HTMLInputElement && (e.target.name === "group" || e.target.name === "office"))
      return;
    // datalist picks fire input with a complete label; typed partial names wait for change
    const values = ["a", "b"].map((k) => String(new FormData(form).get(k) ?? ""));
    if (values.every((v) => !v || byLabel.has(v))) render();
  });
  document.addEventListener("hide-medium-change", render);
  render();
</script>

<style>
  h1 {
    margin-top: 24px;
  }
  .pickers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 640px) {
    .pickers {
      grid-template-columns: 1fr;
    }
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  input {
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    padding: 6px 8px;
    border: 1px solid var(--axis);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
  }
  .office-bar {
    grid-column: 1 / -1;
    display: grid;
    gap: 12px;
  }
  .office-bar p {
    margin: 0;
  }
  .tools {
    margin: 4px 0 8px;
  }
  #result :global(tr.section th) {
    background: var(--surface-2);
    color: var(--ink);
  }
  #result :global(td:first-child) {
    color: var(--ink-2);
    width: 28%;
  }
</style>
