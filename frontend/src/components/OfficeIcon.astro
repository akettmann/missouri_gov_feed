---
// Line drawings for the office tiles on the browse page. Decorative: every tile carries a text label.
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg
  class="office-icon"
  viewBox="0 0 48 48"
  width="40"
  height="40"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "legislature" && (
    // Missouri Capitol: dome and lantern over a columned portico
    <>
      <path d="M24 3v4M18 13a6 6 0 0 1 12 0" />
      <path d="M16 19v-6h16v6" />
      <path d="M8 24l16-6 16 6z" />
      <path d="M11 24v14M17 24v14M23 24v14M25 24v14M31 24v14M37 24v14" />
      <path d="M7 38h34M5 42h38" />
    </>
  )}
  {name === "congress" && (
    // U.S. Capitol: tall dome with statue between two long wings
    <>
      <path d="M24 5v4M22.5 5h3" />
      <path d="M17 19a7 9 0 0 1 14 0" />
      <path d="M17 19h14v6H17zM20 19v6M24 19v6M28 19v6" />
      <path d="M14 31v-6h20v6" />
      <path d="M4 42V31h40v11M9 35v4M14 35v4M19 35v4M29 35v4M34 35v4M39 35v4M24 34v8" />
      <path d="M2 42h44" />
    </>
  )}
  {name === "statewide" && (
    // a seal with a star
    <>
      <circle cx="24" cy="24" r="18" />
      <circle cx="24" cy="24" r="14" stroke-dasharray="2 3" />
      <path d="M24 16l2.2 5.9 6.4.3-5 4 1.7 6.1L24 28.8l-5.3 3.5 1.7-6.1-5-4 6.4-.3z" />
    </>
  )}
  {name === "state_courts" && (
    // a gavel and its sound block
    <>
      <path d="M14.5 14.5l9-9 7 7-9 9z" />
      <path d="M16.75 12.25l7 7M21.25 7.75l7 7" />
      <path d="M26 17l14 14" />
      <path d="M7 42h22M10 42v-4h16v4" />
    </>
  )}
  {name === "federal_courts" && (
    // scales of justice
    <>
      <circle cx="24" cy="7" r="2" />
      <path d="M24 9v31M16 42h16M18 40h12" />
      <path d="M9 14h30" />
      <path d="M9 14l-5 12M9 14l5 12M39 14l-5 12M39 14l5 12" />
      <path d="M3 26h12a6 4 0 0 1-12 0zM33 26h12a6 4 0 0 1-12 0z" />
    </>
  )}
  {name === "mayors" && (
    // city hall with a clock tower
    <>
      <path d="M18 11l6-7 6 7" />
      <path d="M19 11h10v13" />
      <path d="M19 24V11" />
      <circle cx="24" cy="17" r="3" />
      <path d="M24 15.5V17h1.2" />
      <path d="M8 42V24h32v18" />
      <path d="M13 29v4M19 29v4M29 29v4M35 29v4" />
      <path d="M21 42v-6h6v6" />
      <path d="M4 42h40" />
    </>
  )}
  {name === "all" && (
    // every office: a grid of four
    <>
      <rect x="7" y="7" width="14" height="14" rx="3" />
      <rect x="27" y="7" width="14" height="14" rx="3" />
      <rect x="7" y="27" width="14" height="14" rx="3" />
      <rect x="27" y="27" width="14" height="14" rx="3" />
    </>
  )}
  {name === "other" && (
    <>
      <circle cx="24" cy="24" r="18" />
      <path d="M15 24h.01M24 24h.01M33 24h.01" stroke-width="4" />
    </>
  )}
</svg>
