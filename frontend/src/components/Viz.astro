---
// A chart with its table twin. The table is server-rendered (readable without JS); the client script
// (src/scripts/profile.ts) draws the chart from the same spec and redraws both on the medium toggle.
import type { OfficialBundle } from "../lib/exports/types";
import { cellText, VIZ } from "../lib/viz";
import SourceLink from "./SourceLink.astro";

interface Props {
  id: keyof typeof VIZ;
  bundle: OfficialBundle;
}
const { id, bundle } = Astro.props;
const spec = VIZ[id];
const rows = spec.rows(bundle, false);
---

{rows.length > 0 && (
  <figure class="viz" data-viz={id}>
    <figcaption>{spec.title}</figcaption>
    {spec.views && (
      <div class="views js-only" role="group" aria-label="Chart view">
        {spec.views.map((v) => (
          <button type="button" data-view={v} aria-pressed={v === id ? "true" : "false"}>
            {VIZ[v].viewLabel}
          </button>
        ))}
      </div>
    )}
    <div class="chart" aria-hidden="true" />
    {spec.note && <p class="small muted">{spec.note}</p>}
    <details>
      <summary class="small">Table view</summary>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              {spec.columns.map((c) => (
                <th class:list={{ num: c.money || c.num || c.pct }}>{c.label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr data-confidence={r.confidence || undefined}>
                {spec.columns.map((c, i) => (
                  <td class:list={{ num: c.money || c.num || c.pct }}>
                    {c.link ? <SourceLink url={String(r[c.key])} /> : cellText(c, r)}
                    {i === 0 && r.confidence === "medium" && " "}
                    {i === 0 && r.confidence === "medium" && <span class="badge medium">possible match</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </figure>
)}

<style>
  .viz {
    margin: 0 0 20px;
  }
  figcaption {
    font-weight: 600;
    font-size: 0.9375rem;
    margin-bottom: 6px;
  }
  .views {
    display: inline-flex;
    gap: 6px;
    margin-bottom: 8px;
  }
  .views button {
    font: inherit;
    font-size: 0.8125rem;
    padding: 2px 10px;
    border: 1px solid var(--axis);
    border-radius: 4px;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
  }
  .views button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--surface);
    border-color: var(--ink);
  }
</style>
