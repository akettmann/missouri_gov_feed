---
// Section F: court record (fct_case_history, from CourtListener): cases the official decided as a judge or
// argued as an attorney. Facts per case only; outcomes are never tallied into win/loss statistics.
import type { OfficialBundle } from "../lib/exports/types";
import { plural, statusKind } from "../lib/format";
import {
  caseTypeHeading,
  daysLabel,
  coverageText,
  EXCLUDED_TYPES_TEXT,
  excludedDocketsText,
  federalDocketsText,
  hiddenMedianText,
  missingCaseTypes,
  noDocketsText,
  timeToDispositionView,
} from "../lib/timeToDisposition";
import SourceLink from "./SourceLink.astro";
import Viz from "./Viz.astro";

interface Props {
  bundle: OfficialBundle;
}
const { bundle } = Astro.props;
const { courts } = bundle;
const shown = courts.recent.length;
// one median per case type (civil first): a criminal docket takes about twice as long as a civil one, so they are never mixed
const ttds = (courts.time_to_disposition ?? []).map((ttd) => ({ ttd, view: timeToDispositionView(ttd) }));
const missing = missingCaseTypes(ttds.map(({ ttd }) => ttd.case_type));
const DISTRICTS: Record<string, string> = {
  moed: "the Eastern District of Missouri",
  mowd: "the Western District of Missouri",
  "moed+mowd": "the Eastern and Western Districts of Missouri",
};
---

<section class="card" id="courts" aria-labelledby="courts-h">
  <h2 id="courts-h">Court record</h2>
  <p class="lede">
    Published opinions and dockets naming this official as the judge or as an attorney, from CourtListener.
  </p>
  {ttds.length > 0 && (
    <div class="ttd" id="time-to-disposition">
      {ttds.map(({ ttd, view }) => (
        <div class="ttd-type" id={`time-to-disposition-${ttd.case_type}`}>
          <h3 class="ttd-h">{caseTypeHeading(ttd.case_type)}</h3>
          {view.median != null ? (
            <p class="ttd-n">
              <strong>{daysLabel(view.median)}</strong>{" "}
              <span class="muted small">median, filing to termination</span>
            </p>
          ) : (
            <p class="muted">{hiddenMedianText(view.measured, ttd.case_type)}</p>
          )}
          {view.median != null && (
            <p class="small">
              Median days from the filing date to the termination date, over{" "}
              {federalDocketsText(view.measured, ttd.case_type)} in {DISTRICTS[ttd.court_id] ?? ttd.court_id}{" "}
              assigned to this judge on the docket record (any filing year).
              {view.excluded > 0 && ` ${excludedDocketsText(view.excluded)}`}
            </p>
          )}
          <p class="small muted">
            {coverageText(view.measured, view.assigned, ttd.case_type)} ({view.coveragePct}%).
            {view.median != null &&
              view.lowCoverage &&
              ` Fewer than 80% are measured, and dockets still open are not counted, so this median may understate how long this judge's ${ttd.case_type} cases take.`}
          </p>
        </div>
      ))}
      {missing.map((type) => (
        <div class="ttd-type" id={`time-to-disposition-${type}`}>
          <h3 class="ttd-h">{caseTypeHeading(type)}</h3>
          <p class="muted">{noDocketsText(type)}</p>
        </div>
      ))}
      <p class="small">
        Civil and criminal dockets are counted apart because criminal cases tend to take longer than civil
        ones and the mix differs by judge. {EXCLUDED_TYPES_TEXT} A docket counts only if CourtListener has
        both dates, so dockets still open are not counted. "Assigned" is the judge listed on the docket, not
        necessarily the judge who decided it.
      </p>
      <p class="small muted">
        <SourceLink
          url={`https://www.courtlistener.com/person/${ttds[0].ttd.cl_person_id}/`}
          label="source: CourtListener judge"
          context="record"
        />
      </p>
    </div>
  )}
  {statusKind(courts.status) !== "available" ? (
    <p class="muted">No cases: {courts.status}.</p>
  ) : courts.by_year === null ? (
    <p class="muted small">Not available yet (the fct_case_history export is missing).</p>
  ) : (
    <>
      <p class="small">{plural(courts.total, "case", "cases")} in CourtListener.</p>
      <Viz id="cases-by-year" bundle={bundle} />
      <details open={shown <= 8}>
        <summary class="small">{courts.total > shown ? `The ${shown} most recent` : "All of them"}</summary>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Filed</th>
                <th>Case</th>
                <th>Court</th>
                <th>Role</th>
                <th>Disposition</th>
                <th>Source</th>
              </tr>
            </thead>
            <tbody>
              {courts.recent.map((c) => (
                <tr>
                  <td class="nowrap">{c.date_filed ?? "—"}</td>
                  <td class="what">
                    {c.case_name}
                    {c.docket_number && <span class="muted small"> ({c.docket_number})</span>}
                    {c.publication_status === "Unpublished" && <span class="badge">unpublished</span>}
                  </td>
                  <td>{c.court}</td>
                  <td>{c.role}</td>
                  <td>{c.disposition ?? <span class="muted">not stated</span>}</td>
                  <td>
                    <SourceLink url={c.source_url} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </>
  )}
</section>

<style>
  .ttd {
    margin: 12px 0 18px;
  }
  .ttd-type {
    margin: 0 0 14px;
  }
  .ttd-h {
    margin: 0 0 4px;
    font-size: 1rem;
  }
  .ttd-n {
    margin: 0 0 6px;
    font-size: 1.4rem;
  }
  .nowrap {
    white-space: nowrap;
  }
  .what {
    max-width: 44ch;
  }
  .badge {
    margin-left: 6px;
  }
</style>
