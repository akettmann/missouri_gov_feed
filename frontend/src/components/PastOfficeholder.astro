---
// The small page for someone who held an office in a past year but has no full profile (no one serving now
// has this page). Only what the year rosters say: name, offices with years, party, district, sources.
// Same layout for everyone; the profile sections are replaced by one plain note on why they're absent.
import type { PastPerson } from "../lib/exports/types";
import { LEVELS, ROSTER_SOURCES, officeLine, yearRanges } from "../lib/format";
import { href, reportErrorUrl } from "../lib/site";

interface Props {
  person: PastPerson;
  rosterStart: number;
}
const { person, rosterStart } = Astro.props;
const allYears = [...new Set(person.stints.flatMap((s) => s.years))].sort((a, b) => a - b);
const parties = [...new Set(person.stints.map((s) => s.party))];
---

<article>
  <header class="head">
    <p class="small muted crumbs">
      <a href={href("/")}>Officials</a> / Past officeholders
    </p>
    <h1>{person.full_name}</h1>
    <p class="small muted">
      Party:{" "}
      {parties.every((p) => p == null)
        ? "none listed (non-partisan office or not recorded)"
        : parties.map((p) => p ?? "none listed").join(", ")}
    </p>
  </header>

  <section aria-labelledby="held">
    <h2 id="held">Offices held</h2>
    <div class="table-scroll card">
      <table aria-label={`Offices held by ${person.full_name}`}>
        <thead>
          <tr>
            <th>Office</th>
            <th>Level</th>
            <th>Party</th>
            <th>Years</th>
          </tr>
        </thead>
        <tbody>
          {person.stints.map((s) => (
            <tr>
              <td>{officeLine(s)}</td>
              <td>{LEVELS[s.level] ?? s.level}</td>
              <td>{s.party ?? <span class="muted">none listed</span>}</td>
              <td>{yearRanges(s.years)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">
      Years are those in which this person appears on a roster in our data, which starts in {rosterStart};
      earlier or later service may not be shown.
    </p>
    <p class="small">
      Everyone listed for a year:
      {allYears.map((y) => (
        <>
          {" "}
          <a href={href(`/years/${y}/`)}>{y}</a>
        </>
      ))}
    </p>
  </section>

  <section aria-labelledby="note">
    <h2 id="note">What is not shown here</h2>
    <p class="small">
      This person does not hold an office we currently track, so votes, donations, disclosures and the other
      profile sections are not built for them. Roster source:{" "}
      {person.sources.map((s) => ROSTER_SOURCES[s] ?? s).join("; ")}.{" "}
      <a href={href("/methodology/")}>How the data is gathered</a> ·
      <a href={reportErrorUrl(person.full_name, Astro.url.pathname)} rel="noopener" target="_blank">
        Report an error
      </a>
    </p>
  </section>
</article>

<style>
  .head {
    margin-top: 24px;
  }
  h1 {
    margin: 0;
    font-size: 1.75rem;
  }
  .crumbs {
    margin: 0 0 4px;
  }
  section {
    margin-top: 24px;
  }
</style>
