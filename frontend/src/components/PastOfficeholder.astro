---
// The small page for someone who held an office in a past year but has no full profile (no one serving now
// has this page). Only what the year rosters say: name, offices with years, party, district, sources.
// Same layout for everyone; the profile sections are replaced by one plain note on why they're absent.
import type { PastPerson } from "../lib/exports/types";
import { LEVELS, ROSTER_SOURCES, officeLine, rosterDownloadNote, yearRanges } from "../lib/format";
import { SAME_NAME_NOTE, sameNameKindLabel } from "../lib/exports/past";
import { href, reportErrorUrl } from "../lib/site";

interface Props {
  person: PastPerson;
  rosterStart: number;
}
const { person, rosterStart } = Astro.props;
const allYears = [...new Set(person.stints.flatMap((s) => s.years))].sort((a, b) => a - b);
const parties = [...new Set(person.stints.map((s) => s.party))];
---

<article>
  <header class="head">
    <p class="small muted crumbs">
      <a href={href("/")}>Officials</a> / Past officeholders
    </p>
    <h1>{person.full_name}</h1>
    <p class="small muted">
      Party:{" "}
      {parties.every((p) => p == null)
        ? "none listed (non-partisan office or not recorded)"
        : parties.map((p) => p ?? "none listed").join(", ")}
    </p>
  </header>

  <section aria-labelledby="held">
    <h2 id="held">Offices held</h2>
    <div class="table-scroll card">
      <table aria-label={`Offices held by ${person.full_name}`}>
        <thead>
          <tr>
            <th>Office</th>
            <th>Level</th>
            <th>Party</th>
            <th>Years on roster (data starts {rosterStart})</th>
          </tr>
        </thead>
        <tbody>
          {person.stints.map((s) => (
            <tr>
              <td>{officeLine(s)}</td>
              <td>{LEVELS[s.level] ?? s.level}</td>
              <td>{s.party ?? <span class="muted">none listed</span>}</td>
              <td>{yearRanges(s.years)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">
      Years are those in which this person appears on a roster in our data, which starts in {rosterStart}; a
      range such as 2017–2022 is not necessarily the whole length of service.
    </p>
    {person.same_name.length > 0 && (
      <div class="small" data-same-name>
        <p>Shares a name with:</p>
        <ul>
          {person.same_name.map((e) => (
            <li>
              <a href={href(`/officials/${e.slug}/`)}>{e.full_name}</a> ({sameNameKindLabel(e.kind)})
            </li>
          ))}
        </ul>
        <p>{SAME_NAME_NOTE}</p>
      </div>
    )}
    <p class="small">
      Everyone listed for a year:
      {allYears.map((y) => (
        <>
          {" "}
          <a href={href(`/years/${y}/`)}>{y}</a>
        </>
      ))}
    </p>
  </section>

  <section aria-labelledby="note">
    <h2 id="note">What is not shown here</h2>
    <p class="small">
      This roster entry is not linked to a current officeholder profile, so votes, donations, disclosures and
      the other profile sections are not built for it.
    </p>
    <p class="small">Roster sources:</p>
    <ul class="small" data-roster-sources>
      {person.sources.map((s) => {
        const name = ROSTER_SOURCES[s.source] ?? s.source;
        const [only] = s.links;
        const note = rosterDownloadNote(s.source, s.links.length);
        return s.links.length === 1 ? (
          <li>
            {only.url ? (
              <a href={only.url} rel="noopener" target="_blank">
                {name}
              </a>
            ) : (
              name
            )}{" "}
            ({yearRanges(only.years)}){note && <> - {note}</>}
          </li>
        ) : (
          <li>
            {name}:{" "}
            {s.links.map((l, i) => (
              <>
                {i > 0 && "; "}
                {l.url ? (
                  <a href={l.url} rel="noopener" target="_blank">
                    {yearRanges(l.years)}
                  </a>
                ) : (
                  yearRanges(l.years)
                )}
              </>
            ))}
            {note && <> - {note}</>}
          </li>
        );
      })}
    </ul>
    <p class="small">
      <a href={href("/methodology/")}>How the data is gathered</a> ·
      <a href={reportErrorUrl(person.full_name, Astro.url.pathname)} rel="noopener" target="_blank">
        Report an error
      </a>
    </p>
  </section>
</article>

<style>
  .head {
    margin-top: 24px;
  }
  h1 {
    margin: 0;
    font-size: 1.75rem;
  }
  .crumbs {
    margin: 0 0 4px;
  }
  section {
    margin-top: 24px;
  }
</style>
