---
// Section C: money in. Federal officials also get FEC aggregates; everyone with donations gets the
// rpt_donor_rollup views (sample data if that export is missing).
import type { OfficialBundle } from "../lib/exports/types";
import { statusKind } from "../lib/format";
import { href } from "../lib/site";
import SampleBanner from "./SampleBanner.astro";
import Viz from "./Viz.astro";

interface Props {
  bundle: OfficialBundle;
}
const { bundle } = Astro.props;
const { money } = bundle;
const hasFederal = money.federal.length > 0;
const hasRollup = money.cycles.rows.length > 0;
---

<section class="card" id="money" aria-labelledby="money-h">
  <h2 id="money-h">Money in</h2>
  <p class="lede">
    Who funds this official's campaigns, how much, and in what size gifts. Donors are shown as reported, so
    money passed through a PAC appears under the PAC's name (<a href={href("/pacs/")}>What's a PAC?</a>).
  </p>
  {statusKind(money.status) !== "available" && !hasFederal ? (
    <p class="muted">No campaign finance records: {money.status}.</p>
  ) : (
    <>
      {hasFederal && (
        <>
          <h3>Federal campaign (FEC summaries)</h3>
          <div class="grid-2">
            <Viz id="fed-receipts" bundle={bundle} />
            <Viz id="fed-state" bundle={bundle} />
          </div>
          <Viz id="fed-size" bundle={bundle} />
        </>
      )}
      {hasRollup && (
        <>
          <h3>Donors</h3>
          {money.cycles.sample && <SampleBanner model={money.cycles.model} />}
          <div class="grid-2">
            <Viz id="donors-by-cycle" bundle={bundle} />
            <Viz id="top-donors" bundle={bundle} />
          </div>
          <div class="grid-2">
            {money.employers && money.employers.length > 0 && <Viz id="top-employers" bundle={bundle} />}
            {money.size && money.size.length > 0 && <Viz id="state-size" bundle={bundle} />}
          </div>
        </>
      )}
    </>
  )}
</section>
