---
// Office tiles (one per group) and, under the chosen tile, one chip per office. Shared by the browse page and
// /compare so both filter the same way. Radios named "group" and "office"; the page's script shows the chip set
// whose data-group matches the checked tile and does the filtering. Plain fieldsets: render inside a form.
import OfficeIcon from "./OfficeIcon.astro";
import type { OfficeGroup } from "../lib/lookback";

interface Props {
  groups: OfficeGroup[];
}
const { groups } = Astro.props;
---

<fieldset class="tiles">
  <legend>Office</legend>
  <div class="tile-row">
    <label class="tile">
      <input type="radio" name="group" value="" checked />
      <span class="tile-face">
        <OfficeIcon name="all" />
        <span>All offices</span>
      </span>
    </label>
    {groups.map((g) => (
      <label class="tile">
        <input type="radio" name="group" value={g.key} />
        <span class="tile-face">
          <OfficeIcon name={g.key} />
          <span>{g.label}</span>
        </span>
      </label>
    ))}
  </div>
</fieldset>
{groups
  .filter((g) => g.offices.length > 1)
  .map((g) => (
    <fieldset class="chips" data-group={g.key} hidden>
      <legend>{g.label}</legend>
      <label class="chip">
        <input type="radio" name="office" value="" />
        <span>All</span>
      </label>
      {g.offices.map(([o, label]) => (
        <label class="chip">
          <input type="radio" name="office" value={o} />
          <span>{label}</span>
        </label>
      ))}
    </fieldset>
  ))}

<style is:global>
  fieldset.tiles,
  fieldset.chips {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .tiles legend,
  .chips legend {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-2);
    padding: 0;
    margin-bottom: 4px;
  }
  .tile-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(104px, 1fr));
    gap: 8px;
  }
  @media (max-width: 480px) {
    .tile-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .tile,
  .chip {
    position: relative;
    cursor: pointer;
  }
  /* the radio stays focusable and announced; the face next to it draws the state */
  .tile input,
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .tile-face {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 4px;
    height: 100%;
    padding: 10px 6px 8px;
    border: 1px solid var(--axis);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.25;
    text-align: center;
  }
  .tile:hover .tile-face,
  .chip:hover span {
    border-color: var(--ink-2);
  }
  .tile input:checked + .tile-face {
    border-color: var(--focus);
    box-shadow: inset 0 0 0 1px var(--focus);
    background: var(--surface-2);
    color: var(--ink);
    font-weight: 600;
  }
  .tile input:checked + .tile-face::after {
    content: "✓";
    position: absolute;
    top: 4px;
    right: 8px;
    font-size: 0.8125rem;
    color: var(--focus);
  }
  .tile input:focus-visible + .tile-face,
  .chip input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips[hidden] {
    display: none;
  }
  .chips legend {
    width: 100%;
  }
  .chip span {
    display: inline-block;
    padding: 2px 10px;
    border: 1px solid var(--axis);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 0.875rem;
  }
  .chip input:checked + span {
    border-color: var(--focus);
    box-shadow: inset 0 0 0 1px var(--focus);
    background: var(--surface-2);
    color: var(--ink);
    font-weight: 600;
  }
</style>
