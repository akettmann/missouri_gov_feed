@startuml pipeline
title mogov run: how a full refresh flows

|Loaders (stage 1)|
start
:mogov load (all stage-1 loaders);
note right
  Each loader lists its work units and
  processes those its shard owns:
  crc32(unit key) % shards == shard.
  --shards N        all N shards
  --shards N --shard i   one shard
  Cloud Run: CLOUD_RUN_TASK_COUNT/INDEX
  Jobs: (loaders of one service, shard),
  run by --workers processes: different
  services concurrently, slow ones first.
  Shards needing the same URL download
  it once (lock file in data/cache).
end note
fork
  :fetch (cached HTTP, data/cache);
fork again
  :parse PDFs / XML / HTML
  to text rows (no shaping);
end fork
:stream rows to
data/raw/<table>/part-<i>-of-<N>.parquet;

|dbt|
if (any loader failed?) then (yes)
  if (every failed loader allowed?
--allow-failed-loader NAME or
MOGOV_ALLOW_FAILED_LOADERS=NAME) then (yes)
    :warn build.stale_source per loader;
    note right: dbt builds on the last landed raw data
  else (no, strict default)
    :log build.skipped;
    stop
  endif
else (no)
endif
:mogov build (dbt build);
note right
  sources read <table>/*.parquet;
  empty placeholders for optional
  JSON tables that aren't loaded
end note
:staging -> intermediate -> marts
-> reporting;

if (no sources named on the command line?) then (yes, full refresh)
  |Loaders (stage 2)|
  :courtlistener_cases
  (needs marts.fct_legal_careers)
  wikidata
  (needs QIDs from the landed rosters);

  |dbt|
  if (any stage-2 loader failed?) then (yes)
    if (every failed loader allowed?
  --allow-failed-loader NAME or
  MOGOV_ALLOW_FAILED_LOADERS=NAME) then (yes)
      :warn build.stale_source per loader;
      note right: dbt builds on the last landed raw data
    else (no, strict default)
      :log build.skipped;
      stop
    endif
  else (no)
  endif
  :mogov build;
else (no, sources named: stage 1 only)
endif
:exit non-zero if dbt or any loader failed
(even when the failure was allowed), else 0;
stop

note right
  mogov run never calls export. Separately:
  mogov export [--format csv|parquet]
  writes marts and reporting to
  data/exports/<table>.<fmt> (default parquet)
end note
@enduml
