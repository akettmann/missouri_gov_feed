@startuml lineage
title Source -> loader -> raw -> marts -> reporting lineage (from dbt/target/manifest.json, grouped)
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 60

package "Rosters & careers" {
  [openstates_people] as L_os
  [congress_legislators] as L_cl
  [bluebook] as L_bb
  [fjc_judges] as L_fjc
  [courtlistener_bulk] as L_clb
  [courtlistener_case_bulk] as L_ccb
  [wikidata] as L_wd
}
package "Votes" {
  [mo_house] as L_moh
  [mo_senate] as L_mos
  [mo_senate_topics] as L_most
  [voteview] as L_vv
}
package "Money" {
  [fec] as L_fec
  [tap_mec] as L_tap
  [mec\n(opt-in)] as L_mec
}
package "Disclosures" {
  [house_fd] as L_hfd
  [senate_efd\n(opt-in)] as L_efd
  [mo_employee_pay] as L_pay
  [mo_state_expenditures] as L_exp
}
package "Boundaries" {
  [census_tiger] as L_tiger
  [census_zcta] as L_zcta
}
package "Elections" {
  [mo_sos_elections] as L_sos
}
package "Businesses" {
  [epa_frs] as L_epa
}
package "Ratings" {
  [shor_mccarty] as L_sm
}
package "Stage 2" {
  [courtlistener_cases] as L_cc
}
package "seeds" {
  [statewide_officials\nhouse_speakers\nvoluntary_disclosures] as SEEDS
  [mo_county_courts] as S_courts
  [federal_salaries] as S_fedpay
  [interest_keywords\nindustry_subjects] as S_interest
  [company_brands] as S_brands
  [naics_sectors] as S_naics
  [donor_employer_placeholders] as S_empph
}

package "intermediate (identity resolution)" {
  [int_officials__current\nint_officials__name_keys\nint_officials__bios\nint_officials__wikidata] as I_off
  [int_mo_legislators__seats\nint_mo_house__member_identity] as I_seats
  [int_bluebook__county_circuits] as I_circ
  [int_mo_house__votes\nint_mo_senate__votes] as I_votes
  [int_votes__member_votes\nint_votes__party_positions] as I_party
  [int_judges__current\nint_judges__federal\nint_judges__state_index\nint_bluebook__bios\nint_bluebook__judge_bios] as I_judges
  [int_mec__official_committees\nint_mec__contributions_received\nint_mec__committee_names\nint_mec__donor_committees] as I_mec
  [int_bills__subjects] as I_subj
  [int_interests__industry_money] as I_interest
  [int_house_fd__schedule_lines\nint_courtlistener__judge_disclosure_items] as I_fd
  [int_courtlistener__official_people\nint_courtlistener__official_positions] as I_clpos
  [int_courtlistener__mo_cases\nint_courtlistener__bulk_case_matches] as I_cases
  [int_officeholders__years] as I_years
  [int_epa_frs__facilities] as I_frs
}

package "marts" {
  [dim_official] as dim
  [fct_salaries] as F_sal
  [fct_election_races\nfct_judicial_retention] as F_elect
  [fct_legislator_expenses] as F_exp
  [fct_bills\nfct_bill_subjects\nfct_bill_sponsors\nfct_vote_bills] as F_bills
  [dim_district\nfct_official_districts] as D_dist
  [dim_zcta] as D_zcta
  [fct_votes\nfct_federal_votes] as F_votes
  [fct_campaign_finance\nfct_federal_donor_summary\nfct_campaign_spending\nfct_campaign_reports] as F_money
  [fct_lobbyist_gifts] as F_gifts
  [fct_disclosures\nfct_voluntary_disclosures] as F_disc
  [fct_bias_indicators] as F_bias
  [fct_party_unity_yearly] as F_unity
  [fct_office_history] as F_office
  [fct_commercial_ties\nfct_family_ties] as F_ties
  [fct_legal_careers] as F_legal
  [fct_case_history] as F_cases
  [official_profile] as profile
  [fct_district_facilities] as F_fac
  [fct_jurisdiction_businesses] as F_biz
}

package "reporting (frontend views)" {
  [rpt_indicator_peers] as R_peers
  [rpt_party_breaks\nrpt_attendance\nrpt_attendance_pay] as R_votes
  [rpt_donor_rollup\nrpt_committee_donors] as R_money
  [rpt_gift_rollup] as R_gifts
  [rpt_interest_vote_overlap] as R_overlap
  [rpt_officeholders_by_year] as R_years
  [rpt_district_business_industries] as R_ind
  [rpt_votes_by_subject] as R_subj
  [rpt_awards] as R_awards
  [rpt_donor_size] as R_size
  [rpt_donor_employers] as R_emp
}
[voter_frontend\n(dbt exposure)] as EXP

L_os --> I_seats
L_os --> I_off
L_cl --> I_off
L_cl --> dim
L_bb --> I_judges
L_fjc --> I_judges
L_clb --> I_fd
L_clb --> I_clpos
L_wd --> I_off
SEEDS --> I_off
I_judges --> I_off
I_seats --> I_off
I_off --> dim

L_moh --> I_seats
L_moh --> I_votes
L_mos --> I_votes
I_seats --> I_votes
I_votes --> F_votes
L_vv --> F_votes
L_vv --> F_bias
I_votes --> I_party
L_vv --> I_party

L_fec --> F_money
L_tap --> I_mec
L_tap --> F_money
L_tap --> F_gifts
L_mec --> I_mec
L_mec --> F_money
L_mec --> F_gifts
I_mec --> F_money
I_off --> F_gifts

L_hfd --> I_fd
L_efd --> F_disc
I_fd --> F_disc
SEEDS --> F_disc

L_sm --> F_bias
F_votes --> F_unity
I_party --> F_unity
F_unity --> F_bias

I_off --> F_office
I_clpos --> F_office
L_wd --> F_ties
F_disc --> F_ties
I_off --> F_legal

F_legal ..> L_cc : officials to search
F_legal --> I_cases
I_clpos --> I_cases
L_ccb --> I_cases
I_cases --> F_cases
L_cc --> F_cases

dim --> profile
F_votes --> profile
F_money --> profile
F_gifts --> profile
F_disc --> profile
F_bias --> profile
F_office --> profile
F_ties --> profile
F_legal --> profile
F_cases --> profile

L_tiger --> D_dist
L_zcta --> D_zcta
L_pay --> F_sal
L_sos --> F_elect
I_off --> F_elect
L_exp --> F_exp
F_sal --> F_exp
I_seats --> F_sal
I_off --> F_sal
L_moh --> I_subj
L_most --> I_subj
I_subj --> F_bills
L_most --> F_bills
L_moh --> F_bills
I_votes --> F_bills
I_seats --> F_bills
L_bb --> I_circ
I_circ --> D_dist
S_courts --> D_dist
S_fedpay --> F_sal
dim --> D_dist
D_dist --> EXP
D_zcta --> EXP

F_bias --> R_peers
dim --> R_peers
F_votes --> R_votes
I_party --> R_votes
F_sal --> R_votes
F_money --> R_money
I_mec --> R_money
F_gifts --> R_gifts
R_peers --> EXP
R_votes --> EXP
R_money --> EXP
R_gifts --> EXP
F_money --> I_interest
F_gifts --> I_interest
S_interest --> I_interest
I_interest --> R_overlap
F_bills --> R_overlap
F_votes --> R_overlap
S_interest --> R_overlap
R_overlap --> EXP
I_seats --> I_years
L_os --> I_years
L_cl --> I_years
L_fjc --> I_years
I_years --> R_years
dim --> R_years
R_years --> EXP
profile --> EXP

F_votes --> R_subj
F_bills --> R_subj
R_subj --> EXP
dim --> R_awards
R_votes --> R_awards
R_money --> R_awards
F_unity --> R_awards
R_awards --> EXP
F_money --> R_size
R_size --> EXP
F_money --> R_emp
S_empph --> R_emp
R_emp --> EXP

L_epa --> I_frs
I_frs --> F_fac
D_dist --> F_fac
I_frs --> F_biz
F_fac --> F_biz
D_dist --> F_biz
F_money --> F_biz
S_brands --> F_biz
F_biz --> R_ind
S_naics --> R_ind
F_biz --> EXP
R_ind --> EXP
@enduml
